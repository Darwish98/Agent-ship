{
  "name": "agent-ship",
  "version": "0.1.0",
  "description": "Live visualization of Claude Code agent activity as a spaceship crew room",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "install-hooks": "node scripts/install-hooks.js",
    "uninstall-hooks": "node scripts/uninstall-hooks.js",
    "postinstall": "node scripts/install-hooks.js --auto",
    "dist": "electron-builder --mac --win --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.agentship.app",
    "productName": "Agent Ship",
    "files": [
      "src/**/*",
      "hooks/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "hooks", "to": "hooks" }
    ],
    "afterSign": false,
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
